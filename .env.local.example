# Copy this file to .env.local to point the app at a local Supabase stack
# instead of production. .env.local is gitignored - never commit real keys.
#
# 1. npx supabase start
# 2. Copy the printed "API URL" and "anon key" into the values below
# 3. npm run dev

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
